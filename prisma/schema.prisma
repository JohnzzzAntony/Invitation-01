generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("user") // user | admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
}

model Event {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  slug         String   @unique
  type         String   @default("wedding") // wedding | engagement | birthday | anniversary | baby | corporate | party | graduation | religious | other
  status       String   @default("draft") // draft | published | paused | archived
  eventDate    String   @default("") // ISO date string
  startTime    String   @default("17:00")
  endTime      String   @default("23:00")
  timezone     String   @default("Asia/Dubai")
  venue        String   @default("")
  address      String   @default("")
  description  String   @default("")
  hostNames    String   @default("")
  contactEmail String   @default("")
  contactPhone String   @default("")
  // schema-driven website builder
  theme        String   @default("{}") // JSON EventTheme
  sections     String   @default("[]") // JSON SectionData[]
  settings     String   @default("{}") // JSON EventSettings
  // simple JSON collections
  gallery        String @default("[]") // JSON {url, caption}[]
  accommodations String @default("[]") // JSON
  registryItems  String @default("[]") // JSON
  templateId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guests    Guest[]
  groups    GuestGroup[]
  questions RsvpQuestion[]
  responses RsvpResponse[]
  subEvents SubEvent[]
  campaigns Campaign[]
  payments  Payment[]
}

model Template {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  category     String   @default("wedding")
  style        String   @default("modern")
  tags         String   @default("[]") // JSON string[]
  featured     Boolean  @default(false)
  status       String   @default("published") // published | draft
  previewImage String   @default("")
  theme        String   @default("{}") // JSON EventTheme
  sections     String   @default("[]") // JSON SectionData[]
  createdAt    DateTime @default(now())
}

model GuestGroup {
  id          String @id @default(cuid())
  eventId     String
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  color       String @default("#9A7B5B")
  description String @default("")

  guests Guest[]
}

model Guest {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  groupId     String?
  group       GuestGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name        String
  email       String
  status      String    @default("pending") // pending | attending | declined
  partySize   Int       @default(1)
  maxParty    Int       @default(2)
  meal        String?
  dietary     String?
  notes       String?
  token       String    @unique
  invited     Boolean   @default(false)
  invitedAt   DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  responses RsvpResponse[]
}

model RsvpQuestion {
  id              String  @id @default(cuid())
  eventId         String
  event           Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label           String
  type            String  @default("text") // yesno | text | textarea | number | select | radio | checkbox | meal | date
  required        Boolean @default(false)
  options         String  @default("[]") // JSON string[]
  showIfAttending Boolean @default(false) // conditional logic: show only when guest is attending
  order           Int     @default(0)
}

model RsvpResponse {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  attending Boolean
  partySize Int      @default(1)
  answers   String   @default("{}") // JSON { questionId: value }
  createdAt DateTime @default(now())
}

model SubEvent {
  id           String  @id @default(cuid())
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  date         String  @default("")
  startTime    String  @default("")
  endTime      String?
  venue        String?
  description  String?
  dressCode    String?
  rsvpRequired Boolean @default(true)
  groupIds     String  @default("[]") // JSON string[] of GuestGroup ids allowed
}

model Campaign {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  type         String    @default("invitation") // save_the_date | invitation | reminder | confirmation | update | thank_you | custom
  subject      String
  body         String    @default("")
  status       String    @default("draft") // draft | scheduled | sent
  scheduledAt  DateTime?
  sentAt       DateTime?
  sentCount    Int       @default(0)
  openedCount  Int       @default(0)
  clickedCount Int       @default(0)
  createdAt    DateTime  @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestName String
  type      String   @default("donation") // donation | ticket | gift | registry
  amount    Float    @default(0)
  status    String   @default("succeeded")
  method    String   @default("stripe")
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
