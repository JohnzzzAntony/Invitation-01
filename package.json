{
  "name": "ever-rsvp",
  "version": "1.0.0",
  "private": true,
  "description": "Ever RSVP — a pure HTML/CSS/JS event website builder. Next.js is only a static file server for local dev; the product itself has zero runtime dependencies.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "check:js": "node scripts/check-public-js.mjs",
    "check": "bun run lint && bun run check:js",
    "domain": "node scripts/set-domain.mjs",
    "gen:headers": "node scripts/gen-deploy-headers.mjs",
    "gen:landing": "node scripts/gen-landing.mjs",
    "gen:invites": "node scripts/gen-invites.mjs",
    "gen:css": "node scripts/scope-css.mjs",
    "gen:photos": "node scripts/gen-photos.mjs"
  },
  "dependencies": {
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
